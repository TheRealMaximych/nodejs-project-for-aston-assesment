PORT=3000
NODE_ENV=development

# Matches docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aston

# Required. Placeholder only — put a long random value (at least 32 characters) in local .env. Do not commit a real secret.
JWT_SECRET=replace-me-with-a-long-random-string
